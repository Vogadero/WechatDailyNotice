{
  "name": "daily-message-sender",
  "version": "1.0.0",
  "description": "每日消息推送系统",
  "main": "scripts/send-message.js",
  "scripts": {
    "send": "node scripts/send-message.js",
    "preview": "node scripts/send-message.js false --dry-run",
    "preview:morning": "node scripts/send-message.js true --dry-run --run-mode=morning",
    "preview:midday": "node scripts/send-message.js true --dry-run --run-mode=midday",
    "preview:evening": "node scripts/send-message.js true --dry-run --run-mode=evening",
    "test": "node --check scripts/send-message.js && node --check scripts/generate-token.js && node --check scripts/config.js && node --check scripts/utils.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "html-minifier": "^4.0.0",
    "jose": "^6.1.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["daily", "message", "weather", "notification"],
  "author": "Vogadero",
  "license": "MIT"
}
